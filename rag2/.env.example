# Copie para rag2/.env e ajuste. Todos os caminhos têm padrão relativo à raiz do repositório;
# descomente só para apontar outro local.
# Raiz do repositório (código ensemble_llm, scripts/ e runs/ de referência); padrão: diretório pai de rag2/
# RAG2_ORIGEM=..
# JSON brutos do BR-TaxQA-R v1.1 (scripts/download_dataset.py); padrão: <origem>/data/brtaxq
# RAG2_DADOS=../data/brtaxq
# Índice de produção (scripts/build_rag_index.py, não versionado); padrão: <origem>/runs/_shared/rag/br_taxqa_r_bge-m3_cuda1
# RAG2_INDICE_PRODUCAO=../runs/_shared/rag/br_taxqa_r_bge-m3_cuda1
RAG2_DEVICE=cuda:0
# Juiz, auditor e juiz de suficiência (OpenRouter), lida por ensemble_llm.configuracao.Segredos:
OPENROUTER_API_KEY=
